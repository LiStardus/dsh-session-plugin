{
  "name": "@LiStardus/dsh-session-delete",
  "version": "0.1.12",
  "description": "DeepSeek Harness plugin (local fork of @heeweelee/dsh-session-plugin 0.1.11, MIT): recall previously sent messages in the input box with ↑/↓, and permanently delete a workspace session's local records with a right-click.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "dist/client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-session-query": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-workspace": ">=0.1.0-rc.7"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiStardus/dsh-session-delete.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "session",
    "input-history",
    "archive",
    "delete-session"
  ],
  "license": "MIT"
}
